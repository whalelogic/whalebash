# =============================================================================
# config.env — User configuration for whalebash scripts
# Source this file or use load_config.sh to apply these settings.
# =============================================================================

# --- User ---
WHALEBASH_USER="${USER}"
WHALEBASH_FULL_NAME="Your Name"

# --- Paths ---
WHALEBASH_LOG_DIR="${HOME}/.local/share/whalebash/logs"
WHALEBASH_PID_DIR="${HOME}/.local/share/whalebash/pids"

# --- Logging ---
# Log level: DEBUG | INFO | WARN | ERROR
WHALEBASH_LOG_LEVEL="INFO"
WHALEBASH_LOG_TIMESTAMPS="true"

# --- Disk / Memory ---
# Warn when disk usage exceeds this percentage
WHALEBASH_DISK_WARN_PCT=80
# Warn when memory usage exceeds this percentage
WHALEBASH_MEM_WARN_PCT=80

# --- Updates ---
# Package manager to use: auto | apt | dnf | pacman
WHALEBASH_PKG_MANAGER="auto"

# --- Network ---
WHALEBASH_PUBLIC_IP_URL="https://ifconfig.me"
